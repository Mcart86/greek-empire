{
  "cleanUrls": true,
  "functions": {
    "api/upload-image.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    { "source": "/ambassador", "destination": "https://greek-empire-ambassador-sign-up.vercel.app/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/trainer",        "destination": "/trainer/index.html" },
    { "source": "/content-submit", "destination": "/content-submit.html" },
    { "source": "/content-review", "destination": "/content-review.html" },
    { "source": "/quiz",           "destination": "/quiz.html" }
  ]
}
